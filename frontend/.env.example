# 前端环境变量配置示例

# API 基础 URL
VITE_API_BASE_URL=http://localhost:8000/api/v1

# WebSocket 基础 URL（可选，不设置则自动检测）
# VITE_WS_BASE_URL=ws://localhost:8000

# 内网穿透场景：设置此变量后，WebSocket URL 会自动从 HTTP origin 推导
# 例如：VITE_ORIGIN=https://tunnel.example.com → wss://tunnel.example.com
# VITE_ORIGIN=https://tunnel.example.com

# 应用标题
VITE_APP_TITLE=CloudCoder - 视频转码服务

# 允许访问的 hosts（内网穿透域名），多个用逗号分隔
# VITE_ALLOWED_HOSTS=tunnel.example.com,another.example.com

# 启用移动端调试工具 eruda（局域网/内网穿透调试时启用）
# VITE_ENABLE_ERUDA=true
