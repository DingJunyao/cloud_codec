# 应用配置
APP_NAME=码上转
APP_ENV=development
APP_SECRET=change-me-in-production-min-32-chars
APP_URL=http://localhost:8000

# 数据库配置
DATABASE_URL=sqlite+aiosqlite:///./data/cloudcodec.db
# DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/cloudcodec
# DATABASE_URL=mysql+aiomysql://user:pass@localhost:3306/cloudcodec

# Redis 配置
REDIS_URL=redis://localhost:6379/0

# 存储配置
STORAGE_TYPE=local
STORAGE_PATH=./data

# JWT 配置
JWT_SECRET=change-me-in-production-min-32-chars
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30  # 向后兼容，已弃用
JWT_ACCESS_TOKEN_EXPIRE_DAYS=30  # Access token 有效期（天）
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7  # Refresh token 有效期（天）

# CORS 配置
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# 文件上传配置
MAX_UPLOAD_SIZE=10737418240
ALLOWED_VIDEO_TYPES=video/mp4,video/x-matroska,video/webm,video/quicktime,video/x-msvideo

# FFmpeg 配置
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
HW_ACCEL_PRIORITY=nvenc,qsv,vaapi,videotoolbox,amf
